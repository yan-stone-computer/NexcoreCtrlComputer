{
  "name": "nexcorectrlcomputer",
  "version": "0.2.0",
  "description": "Accessibility-first control plane for computer-use agents. One tool, lower token cost, verified actions.",
  "type": "module",
  "license": "MIT",
  "author": "yan-stone-computer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yan-stone-computer/NexcoreCtrlComputer.git"
  },
  "homepage": "https://github.com/yan-stone-computer/NexcoreCtrlComputer",
  "bugs": {
    "url": "https://github.com/yan-stone-computer/NexcoreCtrlComputer/issues"
  },
  "bin": {
